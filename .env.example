# =============================================================================
# Coxinha Cel — Variáveis de ambiente
# =============================================================================
# Copie este arquivo para ".env.local" e preencha os valores reais.
# NUNCA cometa o arquivo ".env.local" no Git (já está no .gitignore padrão
# do Next.js). Nenhuma dessas chaves deve ser publicada no código-fonte.
# =============================================================================

# --- Supabase -----------------------------------------------------------
# URL do projeto Supabase. Encontrada em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon key). Segura para uso no navegador — o controle de
# acesso real é feito por Row Level Security no banco de dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Referência do projeto (o subdomínio antes de ".supabase.co"), usada em
# next.config.ts para liberar otimização de imagens do Supabase Storage.
# Ex.: se a URL for "https://abcdefgh.supabase.co", o valor é "abcdefgh".
NEXT_PUBLIC_SUPABASE_PROJECT_REF=

# Chave de administrador (service role). ATENÇÃO: NUNCA prefixar com
# NEXT_PUBLIC_, nunca importar em código que roda no navegador, e usar
# apenas em Route Handlers/scripts server-only (ex.: jobs administrativos).
# Ainda não é utilizada nesta primeira etapa do projeto.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# URL pública do site em produção, usada para metadados, canonical, sitemap
# e Open Graph (config/site.ts usa esta variável, com fallback para o valor
# abaixo caso não esteja definida). O valor abaixo é um placeholder até a
# loja confirmar o domínio definitivo — ajuste antes de publicar em produção.
NEXT_PUBLIC_SITE_URL=https://www.coxinhacel.com.br
